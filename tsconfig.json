{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "sourceMap": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "paths": {
      "@nest-yalc-2/ag-grid": [
        "./ag-grid/src/index.ts"
      ],
      "@nest-yalc-2/ag-grid/*": [
        "./ag-grid/src/*"
      ],
      "@nest-yalc-2/api-strategy": [
        "./api-strategy/src/index.ts"
      ],
      "@nest-yalc-2/api-strategy/*": [
        "./api-strategy/src/*"
      ],
      "@nest-yalc-2/app": [
        "./app/src/index.ts"
      ],
      "@nest-yalc-2/app/*": [
        "./app/src/*"
      ],
      "@nest-yalc-2/audit": [
        "./audit/src/index.ts"
      ],
      "@nest-yalc-2/audit/*": [
        "./audit/src/*"
      ],
      "@nest-yalc-2/crud-gen": [
        "./crud-gen/src/index.ts"
      ],
      "@nest-yalc-2/crud-gen/*": [
        "./crud-gen/src/*"
      ],
      "@nest-yalc-2/data-loader": [
        "./data-loader/src/index.ts"
      ],
      "@nest-yalc-2/data-loader/*": [
        "./data-loader/src/*"
      ],
      "@nest-yalc-2/database": [
        "./database/src/index.ts"
      ],
      "@nest-yalc-2/database/*": [
        "./database/src/*"
      ],
      "@nest-yalc-2/errors": [
        "./errors/src/index.ts",
        "./node_modules/@node-yalc/errors/src/index.ts"
      ],
      "@nest-yalc-2/errors/*": [
        "./errors/src/*",
        "./node_modules/@node-yalc/errors/src/*"
      ],
      "@nest-yalc-2/event-manager": [
        "./event-manager/src/index.ts",
        "./node_modules/@node-yalc/event-manager/src/index.ts"
      ],
      "@nest-yalc-2/event-manager/*": [
        "./event-manager/src/*",
        "./node_modules/@node-yalc/event-manager/src/*"
      ],
      "@nest-yalc-2/field-middleware": [
        "./field-middleware/src/index.ts"
      ],
      "@nest-yalc-2/field-middleware/*": [
        "./field-middleware/src/*"
      ],
      "@nest-yalc-2/graphql": [
        "./graphql/src/index.ts"
      ],
      "@nest-yalc-2/graphql/*": [
        "./graphql/src/*"
      ],
      "@nest-yalc-2/jest": [
        "./jest/src/index.ts"
      ],
      "@nest-yalc-2/jest/*": [
        "./jest/src/*"
      ],
      "@nest-yalc-2/kafka": [
        "./kafka/src/index.ts"
      ],
      "@nest-yalc-2/kafka/*": [
        "./kafka/src/*"
      ],
      "@nest-yalc-2/logger": [
        "./logger/src/index.ts",
        "./node_modules/@node-yalc/logger/src/index.ts"
      ],
      "@nest-yalc-2/logger/*": [
        "./logger/src/*",
        "./node_modules/@node-yalc/logger/src/*"
      ],
      "@nest-yalc-2/observability": [
        "./observability/src/index.ts"
      ],
      "@nest-yalc-2/observability/*": [
        "./observability/src/*"
      ],
      "@nest-yalc-2/sentinel": [
        "./sentinel/src/index.ts"
      ],
      "@nest-yalc-2/sentinel/*": [
        "./sentinel/src/*"
      ],
      "@nest-yalc-2/types": [
        "./types/src/index.ts",
        "./node_modules/@node-yalc/types/src/index.ts"
      ],
      "@nest-yalc-2/types/*": [
        "./types/src/*",
        "./node_modules/@node-yalc/types/src/*"
      ],
      "@nest-yalc-2/types-extends": [
        "./types-extends/src/index.ts",
        "./node_modules/@node-yalc/types-extends/src/index.ts"
      ],
      "@nest-yalc-2/types-extends/*": [
        "./types-extends/src/*",
        "./node_modules/@node-yalc/types-extends/src/*"
      ],
      "@nest-yalc-2/utils": [
        "./utils/src/index.ts",
        "./node_modules/@node-yalc/utils/src/index.ts"
      ],
      "@nest-yalc-2/utils/*": [
        "./utils/src/*",
        "./node_modules/@node-yalc/utils/src/*"
      ],
      "@nest-yalc-2/omnikernel-module": [
        "./examples/omnikernel/module/src/index.ts"
      ],
      "@nest-yalc-2/omnikernel-module/*": [
        "./examples/omnikernel/module/src/*"
      ],
      "graphql": [
        "./node_modules/graphql"
      ],
      "ferrox-saas-backend": [
        "./apps/ferrox-saas-backend/src/index.ts"
      ],
      "ferrox-saas-backend/*": [
        "./apps/ferrox-saas-backend/src/*"
      ],
      "nestjs-yalc": [
        "./types/src/index.ts"
      ],
      "nestjs-yalc/*": [
        "./types/src/*"
      ]
    },
    "moduleResolution": "NodeNext"
  },
  "include": [
    "**/src/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "var",
    "var/**",
    "dist",
    "**/dist/**",
    "apps",
    "node-yalc",
    "**/*spec.ts",
    "**/__tests__",
    "**/__mocks__",
    "**/.webpack",
    "examples/task",
    "examples/skeleton",
    "examples/omnikernel/app"
  ],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}