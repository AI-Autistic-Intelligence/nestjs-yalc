  "dependencies": {
    "tslib": "^2.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nek97/nestjs-yalc.git"
  },
  "bugs": {
    "url": "https://github.com/Nek97/nestjs-yalc/issues"
  },
  "homepage": "https://github.com/Nek97/nestjs-yalc#readme",
  "publishConfig": {
    "access": "public"
  }
}
